// A longer run: a deterministic queue simulation with structs, enums, maps, and
// events. `simulate steps` prints a summary; two modes fail on purpose.
import io { println, eprintln, args }

import collections { get, len, push, pop, range, map_new, map_has, map_keys }

import str { parse_int }

import option { Some, None }

import result { Ok, Err }

event Tick(n: Int)

let mut ticks = 0

let doubled = ticks * 2

on Tick { n ->
    ticks = ticks + n
}

watch doubled {
    if doubled % 200 == 0 {
        println("ticks reached {ticks}")
    }
}

enum Job {
    Short(Int),
    Long(Task),
    Idle
}

struct Task {
    id: Int,
    weight: Int
}

struct State {
    seed: Int,
    done: Int,
    waited: Int
}

fn next_seed(seed: Int) -> Int {
    (seed * 1103515245 + 12345) % 2147483648
}

fn job_for(seed: Int, step: Int) -> Job {
    match seed % 3 {
        0 => Short(seed % 10),
        1 => Long(Task { id: step, weight: seed % 100 }),
        _ => Idle
    }
}

fn step(s: State, at: Int) -> State {
    let seed = next_seed(s.seed)
    match job_for(seed, at) {
        Short(n) => State { seed: seed, done: s.done + 1, waited: s.waited + n },
        Long(t) => State { seed: seed, done: s.done + 1, waited: s.waited + t.weight * 2 },
        Idle => State { seed: seed, done: s.done, waited: s.waited }
    }
}

fn bucket_name(waited: Int) -> String {
    match waited % 4 { 0 => "a", 1 => "b", 2 => "c", _ => "d" }
}

fn run(steps: Int) -> State {
    let mut s = State { seed: 42, done: 0, waited: 0 }
    let mut buckets: Map[String, Int] = map_new()
    let mut history: [Int] = []
    for i in range(steps) {
        s = step(s, i)
        let name = bucket_name(s.waited)
        let seen = if map_has(buckets, name) { buckets[name] } else { 0 }
        buckets[name] = seen + 1
        history = push(history, s.waited)
        if len(history) > 100 {
            history = pop(history)
        }
        if i % 100 == 0 {
            emit Tick(1)
        }
    }
    for key in map_keys(buckets) {
        println("{key}: {buckets[key]}")
    }
    println("last: {history[len(history) - 1]}")
    s
}

fn depth(n: Int) -> Int {
    depth(n + 1) + 1
}

fn main() -> Int {
    let argv = args()
    match get(argv, 0) {
        Some("recurse") => {
            println("{depth(0)}")
            0
        },
        Some("oversize") => {
            println("{len(range(100000000000))}")
            0
        },
        Some(text) => match parse_int(text) {
            Ok(steps) => {
                let s = run(steps)
                println("done {s.done}, waited {s.waited}, seed {s.seed}")
                0
            },
            Err(e) => {
                eprintln("error: {e}")
                2
            }
        },
        None => {
            eprintln("usage: simulate <steps>|recurse|oversize")
            2
        }
    }
}
