// A calculator: tokenizes and parses its argument into a tree, then evaluates it.
// Exit status: 0 for a value, 1 for a bad expression or a failed evaluation, 2 for bad usage.
import io { println, eprintln, args }

import collections { get, len, push }

import str { str_chars, str_contains, parse_int }

import option { Some, None }

import result { Ok, Err }

enum Token {
    Num(Int),
    Op(String),
    Open,
    Close
}

enum Expr {
    Lit(Int),
    Neg(Expr),
    Bin(BinOp)
}

struct BinOp {
    op: String,
    left: Expr,
    right: Expr
}

struct Parsed {
    expr: Expr,
    next: Int
}

fn tokenize(text: String) -> Result[[Token], String] {
    let chars = str_chars(text)
    let mut tokens: [Token] = []
    let mut i = 0
    while i < len(chars) {
        let c = chars[i]
        if c == " " {
            i = i + 1
        } else if str_contains("0123456789", c) {
            let mut digits = ""
            while i < len(chars) && str_contains("0123456789", chars[i]) {
                digits = digits + chars[i]
                i = i + 1
            }
            let n = parse_int(digits)?
            tokens = push(tokens, Num(n))
        } else if str_contains("+-*/", c) {
            tokens = push(tokens, Op(c))
            i = i + 1
        } else if c == "(" {
            tokens = push(tokens, Open)
            i = i + 1
        } else if c == ")" {
            tokens = push(tokens, Close)
            i = i + 1
        } else {
            return Err("unexpected character `{c}` at {i}")
        }
    }
    Ok(tokens)
}

fn op_at(tokens: [Token], at: Int, ops: String) -> Option[String] {
    match get(tokens, at) {
        Some(Op(o)) => if str_contains(ops, o) { Some(o) } else { None },
        _ => None
    }
}

fn parse_binary(tokens: [Token], at: Int, ops: String, next: fn([Token], Int) -> Result[Parsed, String]) -> Result[Parsed, String] {
    let mut left = next(tokens, at)?
    let mut going = true
    while going {
        match op_at(tokens, left.next, ops) {
            Some(o) => {
                let right = next(tokens, left.next + 1)?
                left = Parsed { expr: Bin(BinOp { op: o, left: left.expr, right: right.expr }), next: right.next }
            },
            None => {
                going = false
            }
        }
    }
    Ok(left)
}

fn parse_sum(tokens: [Token], at: Int) -> Result[Parsed, String] {
    parse_binary(tokens, at, "+-", parse_product)
}

fn parse_product(tokens: [Token], at: Int) -> Result[Parsed, String] {
    parse_binary(tokens, at, "*/", parse_atom)
}

fn parse_atom(tokens: [Token], at: Int) -> Result[Parsed, String] {
    match get(tokens, at) {
        Some(Num(n)) => Ok(Parsed { expr: Lit(n), next: at + 1 }),
        Some(Op(o)) => {
            if o != "-" {
                return Err("unexpected `{o}`")
            }
            let inner = parse_atom(tokens, at + 1)?
            Ok(Parsed { expr: Neg(inner.expr), next: inner.next })
        },
        Some(Open) => {
            let inner = parse_sum(tokens, at + 1)?
            match get(tokens, inner.next) {
                Some(Close) => Ok(Parsed { expr: inner.expr, next: inner.next + 1 }),
                _ => Err("expected `)`")
            }
        },
        Some(Close) => Err("unexpected `)`"),
        None => Err("unexpected end of expression")
    }
}

fn eval(e: Expr) -> Result[Int, String] {
    match e {
        Lit(n) => Ok(n),
        Neg(inner) => {
            let v = eval(inner)?
            Ok(0 - v)
        },
        Bin(b) => {
            let l = eval(b.left)?
            let r = eval(b.right)?
            match b.op {
                "+" => Ok(l + r),
                "-" => Ok(l - r),
                "*" => Ok(l * r),
                _ => if r == 0 { Err("division by zero") } else { Ok(l / r) }
            }
        }
    }
}

fn calculate(text: String) -> Result[Int, String] {
    let tokens = tokenize(text)?
    let parsed = parse_sum(tokens, 0)?
    if parsed.next != len(tokens) {
        return Err("trailing input after token {parsed.next}")
    }
    eval(parsed.expr)
}

fn main() -> Int {
    let argv = args()
    if len(argv) != 1 {
        eprintln("usage: calc <expression>")
        return 2
    }
    match calculate(argv[0]) {
        Ok(v) => {
            println("{v}")
            0
        },
        Err(e) => {
            eprintln("error: {e}")
            1
        }
    }
}
