// Tokenizer and recursive-descent evaluator for `+`, `*`, and parentheses:
// enums, `match`, `Result` with `?`, and string interpolation.
import io { println }

import str { str_chars, parse_int }

import collections { len, get, push }

import result { Ok, Err }

import option { Some, None }

enum Tok {
    Num(Int),
    Plus,
    Star,
    LParen,
    RParen
}

fn is_digit(c: String) -> Bool {
    c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
}

fn tokenize(src: String) -> Result[[Tok], String] {
    let chars = str_chars(src)
    let mut toks: [Tok] = []
    let mut num = ""
    for c in chars {
        if is_digit(c) {
            num = num + c
            continue
        }
        if num != "" {
            toks = push(toks, Num(parse_int(num)?))
            num = ""
        }
        if c == "+" {
            toks = push(toks, Plus)
        } else if c == "*" {
            toks = push(toks, Star)
        } else if c == "(" {
            toks = push(toks, LParen)
        } else if c == ")" {
            toks = push(toks, RParen)
        } else if c != " " {
            return Err("unexpected character `{c}`")
        }
    }
    if num != "" {
        toks = push(toks, Num(parse_int(num)?))
    }
    Ok(toks)
}

struct Parsed {
    value: Int,
    next: Int
}

fn tok_at(toks: [Tok], i: Int) -> Option[Tok] {
    get(toks, i)
}

fn atom(toks: [Tok], i: Int) -> Result[Parsed, String] {
    match tok_at(toks, i) {
        Some(Num(n)) => Ok(Parsed { value: n, next: i + 1 }),
        Some(LParen) => {
            let inner = sum(toks, i + 1)?
            match tok_at(toks, inner.next) { Some(RParen) => Ok(Parsed { value: inner.value, next: inner.next + 1 }), _ => Err("expected `)`") }
        },
        None => Err("unexpected end of input"),
        _ => Err("expected a number or `(` at token {i}")
    }
}

fn product(toks: [Tok], i: Int) -> Result[Parsed, String] {
    let mut left = atom(toks, i)?
    while true {
        match tok_at(toks, left.next) {
            Some(Star) => {
                let right = atom(toks, left.next + 1)?
                left = Parsed { value: left.value * right.value, next: right.next }
            },
            _ => break
        }
    }
    Ok(left)
}

fn sum(toks: [Tok], i: Int) -> Result[Parsed, String] {
    let mut left = product(toks, i)?
    while true {
        match tok_at(toks, left.next) {
            Some(Plus) => {
                let right = product(toks, left.next + 1)?
                left = Parsed { value: left.value + right.value, next: right.next }
            },
            _ => break
        }
    }
    Ok(left)
}

fn eval(src: String) -> Result[Int, String] {
    let toks = tokenize(src)?
    let p = sum(toks, 0)?
    if p.next != len(toks) {
        return Err("trailing input")
    }
    Ok(p.value)
}

fn show(src: String) {
    match eval(src) { Ok(v) => println("{src} = {v}"), Err(e) => println("{src}: error: {e}") }
}

fn main() -> Int {
    show("1 + 2 * 3")
    show("(1 + 2) * 3")
    show("2 * (3 + 4) * 5")
    show("1 + ")
    show("7 $ 2")
    0
}
