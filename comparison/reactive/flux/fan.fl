on Set(v) {
    s = v
}

watch total {
    emit Seen(total)
}

fn main() {
    let t0 = now()
    let mut i = 0
    while i < 1000 {
        emit Set(i + 1)
        i += 1
    }
    let t1 = now()
    println("{snap(seen)} {t1 - t0}")
}
