import io { println }
import time { now }

event Seen(v: Int)

on Seen(v) {
    seen += v
}

event Tick

event Make(n: Int)

live fn Counter(start: Int) {
    pub let mut n = start
    pub derived double = n * 2

    on Tick {
        n += 1
    }
}

let mut all: [Counter] = []

let mut seen = 0

derived total = all.map(|c| c.double).reduce(0, |x, y| x + y)

on Make(n) {
    let mut i = 0
    while i < n {
        all.push(Counter(i))
        i += 1
    }
}

watch total {
    emit Seen(total)
}

fn main() {
    let t0 = now()
    emit Make(1000)
    let t1 = now()
    let mut i = 0
    while i < 100 {
        emit Tick()
        i += 1
    }
    let t2 = now()
    println("{snap(seen)} {t1 - t0} {t2 - t1}")
}
