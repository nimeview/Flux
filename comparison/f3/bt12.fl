import io { println }

enum Tree {
    Leaf,
    Node { l: Tree, r: Tree }
}

fn make(depth: Int) -> Tree {
    if depth == 0 {
        Node { l: Leaf, r: Leaf }
    } else {
        Node { l: make(depth - 1), r: make(depth - 1) }
    }
}

fn check(t: Tree) -> Int {
    match t {
        Leaf => 0,
        Node { l, r } => 1 + check(l) + check(r)
    }
}

fn main() {
    let max_depth = 12
    let mut total = check(make(max_depth + 1))
    let long_lived = make(max_depth)
    let mut depth = 4
    while depth <= max_depth {
        let iterations = 1 << (max_depth - depth + 4)
        let mut i = 0
        while i < iterations {
            total += check(make(depth))
            i += 1
        }
        depth += 2
    }
    total += check(long_lived)
    println("{total}")
}
