import io { println }
import math { sqrt }

struct Body {
    x: Float,
    y: Float,
    z: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    mass: Float
}

fn energy(bodies: [Body]) -> Float {
    let mut e = 0.0
    let n = bodies.len()
    let mut i = 0
    while i < n {
        let b = bodies[i]
        e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        let mut j = i + 1
        while j < n {
            let c = bodies[j]
            let dx = b.x - c.x
            let dy = b.y - c.y
            let dz = b.z - c.z
            e -= b.mass * c.mass / sqrt(dx * dx + dy * dy + dz * dz)
            j += 1
        }
        i += 1
    }
    e
}

fn advance(mut bodies: [Body], dt: Float) {
    let n = bodies.len()
    let mut i = 0
    while i < n {
        let mut j = i + 1
        while j < n {
            let dx = bodies[i].x - bodies[j].x
            let dy = bodies[i].y - bodies[j].y
            let dz = bodies[i].z - bodies[j].z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * sqrt(d2))
            let mi = bodies[i].mass
            let mj = bodies[j].mass
            bodies[i].vx -= dx * mj * mag
            bodies[i].vy -= dy * mj * mag
            bodies[i].vz -= dz * mj * mag
            bodies[j].vx += dx * mi * mag
            bodies[j].vy += dy * mi * mag
            bodies[j].vz += dz * mi * mag
            j += 1
        }
        i += 1
    }
    let mut k = 0
    while k < n {
        bodies[k].x += dt * bodies[k].vx
        bodies[k].y += dt * bodies[k].vy
        bodies[k].z += dt * bodies[k].vz
        k += 1
    }
}

fn main() {
    let pi = 3.141592653589793
    let solar = 4.0 * pi * pi
    let days = 365.24
    let mut bodies = [
        Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar },
        Body { x: 4.84143144246472090, y: -1.16032004402742839, z: -0.103622044471123109, vx: 0.00166007664274403694 * days, vy: 0.00769901118419740425 * days, vz: -0.0000690460016972063023 * days, mass: 0.000954791938424326609 * solar },
        Body { x: 8.34336671824457987, y: 4.12479856412430479, z: -0.403523417114321381, vx: -0.00276742510726862411 * days, vy: 0.00499852801234917238 * days, vz: 0.0000230417297573763929 * days, mass: 0.000285885980666130812 * solar },
        Body { x: 12.894369562139131, y: -15.111151401698631, z: -0.22330757889265573, vx: 0.0029646018915851645 * days, vy: 0.0023784717395948095 * days, vz: -0.000029658956854023756 * days, mass: 0.000043662440433515637 * solar },
        Body { x: 15.379697114850917, y: -25.919314609987964, z: 0.17925877295037118, vx: 0.0026806777249038932 * days, vy: 0.001628241700382423 * days, vz: -0.000095159225451971587 * days, mass: 0.000051513890204661145 * solar }
    ]
    let mut px = 0.0
    let mut py = 0.0
    let mut pz = 0.0
    for b in bodies {
        px += b.vx * b.mass
        py += b.vy * b.mass
        pz += b.vz * b.mass
    }
    bodies[0].vx = 0.0 - px / solar
    bodies[0].vy = 0.0 - py / solar
    bodies[0].vz = 0.0 - pz / solar
    let before = energy(bodies)
    let mut step = 0
    while step < 100000 {
        advance(mut bodies, 0.01)
        step += 1
    }
    let after = energy(bodies)
    println("{(before * 1000000000.0) as Int} {(after * 1000000000.0) as Int}")
}
