import io { println }
import math { sqrt }

fn a(i: Int, j: Int) -> Float {
    1.0 / ((i + j) * (i + j + 1) / 2 + i + 1) as Float
}

fn mul_av(v: [Float], n: Int) -> [Float] {
    let mut out: [Float] = []
    let mut i = 0
    while i < n {
        let mut sum = 0.0
        let mut j = 0
        while j < n {
            sum += a(i, j) * v[j]
            j += 1
        }
        out.push(sum)
        i += 1
    }
    out
}

fn mul_atv(v: [Float], n: Int) -> [Float] {
    let mut out: [Float] = []
    let mut i = 0
    while i < n {
        let mut sum = 0.0
        let mut j = 0
        while j < n {
            sum += a(j, i) * v[j]
            j += 1
        }
        out.push(sum)
        i += 1
    }
    out
}

fn main() {
    let n = 250
    let mut u: [Float] = []
    let mut i = 0
    while i < n {
        u.push(1.0)
        i += 1
    }
    let mut v: [Float] = []
    let mut k = 0
    while k < 10 {
        v = mul_atv(mul_av(u, n), n)
        u = mul_atv(mul_av(v, n), n)
        k += 1
    }
    let mut vbv = 0.0
    let mut vv = 0.0
    let mut j = 0
    while j < n {
        vbv += u[j] * v[j]
        vv += v[j] * v[j]
        j += 1
    }
    let r = sqrt(vbv / vv)
    println("{(r * 1000000000.0) as Int}")
}
