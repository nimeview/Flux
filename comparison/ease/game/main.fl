import io { println }

import time { after, every, cancel, stop }

import collections { range }

const WIDTH = 12

const TICKS = 20

const TICK_MS = 20

event Countdown(n: Int)

event Tick

event Kick(speed: Int)

let mut pos = 0

let mut vel = 1

let mut ticks = 0

let mut bounces = 0

let mut timer = 0

derived row = draw(pos)

fn draw(p: Int) -> String {
    let mut s = "|"
    for i in range(WIDTH + 1) {
        s += if i == p { "o" } else { "." }
    }
    s + "|"
}

// Scripted input: which kick happens at which tick.
fn script(t: Int) -> Option[Int] {
    match t { 5 => Some(2), 11 => Some(-3), 16 => Some(1), _ => None }
}

on Countdown(n) {
    if n > 0 {
        println("{n}...")
        after(50, Countdown(n - 1))
    } else {
        println("go!")
        timer = every(TICK_MS, Tick())
    }
}

on Kick(speed) {
    println("  kick: velocity {vel} -> {speed}")
    vel = speed
}

on Tick {
    ticks += 1
    let kick = script(ticks)
    if kick != None {
        emit Kick(kick.unwrap_or(0))
    }
    let mut next = pos + vel
    if next < 0 {
        next = -next
        vel = -vel
        bounces += 1
    } else if next > WIDTH {
        next = 2 * WIDTH - next
        vel = -vel
        bounces += 1
    }
    pos = next
    println("tick {ticks}: {row}")
    if ticks >= TICKS {
        cancel(timer)
        stop()
    }
}

watch bounces {
    if bounces > 0 {
        println("  bounce #{bounces}")
    }
}

fn main() {
    emit Countdown(3)
}
