import io { println, eprintln, args, read_file }

import collections { map_new }

// Keep letters and digits; everything else becomes a space.
fn normalize(text: String) -> String {
    let lower = text.to_lower()
    let mut out = ""
    for c in lower.chars() {
        if c >= "a" && c <= "z" || c >= "0" && c <= "9" {
            out += c
        } else {
            out += " "
        }
    }
    out
}

fn count_words(text: String) -> Map[String, Int] {
    let mut counts: Map[String, Int] = map_new()
    for w in normalize(text).words() {
        counts[w] = counts.get_or(w, 0) + 1
    }
    counts
}

// Map iteration is in key order and sorted_by is stable, so ties stay alphabetical.
fn main() -> Int {
    let argv = args()
    if argv.len() < 1 {
        eprintln("usage: wordfreq FILE")
        return 1
    }
    let path = argv[0]
    let text = match read_file(path) {
        Ok(t) => t,
        Err(e) => {
            eprintln("wordfreq: {e}")
            return 1
        }
    }
    let counts = count_words(text)
    let mut entries: [(String, Int)] = []
    for (w, n) in counts {
        entries.push((w, n))
    }
    let ranked = entries.sorted_by(|e| -e.1)
    for (i, e) in ranked.enumerate() {
        if i >= 10 {
            break
        }
        println("{e.1} {e.0}")
    }
    0
}
