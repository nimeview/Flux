// U+FEFF: a byte-order mark that some editors write at the start of a file.
WHITESPACE = _{ " " | "\t" | "\r" | "\n" | "\u{FEFF}" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }

program = { SOI ~ item* ~ EOI }

item = {
    import_decl
  | type_alias_decl
  | struct_decl
  | enum_decl
  | trait_decl
  | impl_decl
  | event_decl
  | fn_decl
  | rfn_decl
  | watch_stmt
  | on_stmt
  | const_binding
  | derived_binding
  | let_binding
  | if_stmt
}

type_alias_decl = { pub_modifier? ~ "type" ~ ident ~ "=" ~ type_name }
const_binding = { pub_modifier? ~ "const" ~ ident ~ type_ann? ~ "=" ~ expr }
derived_binding = { pub_modifier? ~ "derived" ~ let_pattern ~ type_ann? ~ "=" ~ expr }
let_binding = { pub_modifier? ~ "let" ~ mut_modifier? ~ let_pattern ~ type_ann? ~ "=" ~ expr }
mut_modifier = { "mut" }
let_pattern = { struct_pat | ident }
import_decl = { "import" ~ import_path ~ import_as? ~ import_symbols? }
import_as = { kw_as ~ ident }
import_path = @{ (ASCII_ALPHANUMERIC | "_" | "." | "/")+ }
import_symbols = { "{" ~ ident_list ~ "}" }
ident_list = { ident ~ ("," ~ ident)* }

pub_modifier = { "pub" }

struct_decl = { pub_modifier? ~ "struct" ~ ident ~ type_params? ~ struct_fields }
struct_fields = { "{" ~ struct_field ~ ("," ~ struct_field)* ~ "}" }
struct_field = { ident ~ ":" ~ type_name }

enum_decl = { pub_modifier? ~ "enum" ~ ident ~ enum_variants }
enum_variants = { "{" ~ enum_variant ~ ("," ~ enum_variant)* ~ "}" }
enum_variant = { ident ~ enum_payload? }
enum_payload = { tuple_payload | struct_payload }
// More than one type parses so that the parser can explain the rule.
tuple_payload = { "(" ~ type_name ~ ("," ~ type_name)* ~ ")" }
struct_payload = { "{" ~ struct_field ~ ("," ~ struct_field)* ~ "}" }

event_decl = { pub_modifier? ~ "event" ~ ident ~ event_params? }
event_params = { "(" ~ param_list? ~ ")" }

type_params = { "[" ~ ident ~ ("," ~ ident)* ~ "]" }

trait_decl = { pub_modifier? ~ "trait" ~ ident ~ trait_body }
trait_body = { "{" ~ trait_method* ~ "}" }
trait_method = { "fn" ~ ident ~ fn_sig ~ ";" }

impl_decl = { "impl" ~ ident ~ "for" ~ type_name ~ impl_body }
impl_body = { "{" ~ impl_method* ~ "}" }
impl_method = { "fn" ~ ident ~ fn_sig ~ block }

fn_decl = { pub_modifier? ~ "fn" ~ ident ~ type_params? ~ fn_sig ~ block }
rfn_decl = { pub_modifier? ~ "rfn" ~ ident ~ type_params? ~ fn_sig ~ block }
fn_sig = { "(" ~ param_list? ~ ")" ~ return_type? }
return_type = { "->" ~ type_name }

watch_stmt = { "watch" ~ ident? ~ block }
on_stmt = { "on" ~ ident ~ handler }

handler = { "{" ~ handler_body ~ "}" }
handler_body = { handler_param ~ block_stmts | block_stmts }
handler_param = { ident ~ "->" }

block = { "{" ~ block_stmts ~ "}" }
block_stmts = { stmt* }

stmt = {
    let_stmt
  | assign_stmt
  | emit_stmt
  | return_stmt
  | break_stmt
  | continue_stmt
  | if_stmt
  | while_stmt
  | for_stmt
  | watch_stmt
  | on_stmt
  | expr_stmt
}

// Keywords end at a word boundary: `breaker` is a name, not `break er`.
return_stmt = { kw_return ~ expr? }
kw_return = @{ "return" ~ kw_end }
break_stmt = @{ "break" ~ kw_end }
continue_stmt = @{ "continue" ~ kw_end }

let_stmt = { "let" ~ mut_modifier? ~ let_pattern ~ type_ann? ~ "=" ~ expr }
// `x = v`, or an element: `xs[i] = v`, `grid[i][j] = v`, `m[k] = v`.
assign_stmt = { ident ~ assign_index* ~ "=" ~ expr }
assign_index = { "[" ~ expr ~ "]" }
emit_stmt = { "emit" ~ ident ~ emit_args? }
emit_args = { "(" ~ expr_list? ~ ")" }
expr_stmt = { expr }

if_stmt = { "if" ~ expr ~ block ~ else_clause? }
else_clause = { kw_else ~ (if_stmt | block) }
while_stmt = { "while" ~ expr ~ block }
for_stmt = { "for" ~ ident ~ kw_in ~ expr ~ block }

// Expressions — precedence low → high
// `match`/`if` are reached as operands (see `primary_expr`).
expr = { or_expr }

match_expr = { kw_match ~ or_expr ~ "{" ~ match_arm ~ ("," ~ match_arm)* ~ "}" }
kw_match = @{ "match" ~ kw_end }
match_arm = { match_pattern ~ guard? ~ "=>" ~ (arm_block | arm_jump | expr) }
// An arm that leaves instead of producing a value: `Err(e) => return Err(e)`.
arm_jump = { return_stmt | break_stmt | continue_stmt }
arm_block = { "{" ~ block_stmts ~ "}" }
guard = { kw_if ~ expr }
match_pattern = { lit_pat | tuple_pat | struct_pat | simple_pat }
// Int, String, and Bool literals; compared with `==`.
lit_pat = { float_lit | neg_int_lit | int_lit | string_lit | bool_lit }
neg_int_lit = ${ "-" ~ int_lit }
simple_pat = { ident }
// The payload may itself be a pattern: `Some(Num(n))`, `Ok(0)`, `Some(LParen)`.
tuple_pat = { ident ~ "(" ~ (lit_pat | tuple_pat | ident_list)? ~ ")" }
struct_pat = { ident ~ "{" ~ ident_list ~ "}" }

if_expr = { kw_if ~ or_expr ~ "{" ~ expr ~ "}" ~ kw_else ~ "{" ~ expr ~ "}" }

or_expr = { and_expr ~ ("||" ~ and_expr)* }
and_expr = { eq_expr ~ ("&&" ~ eq_expr)* }
eq_expr = { rel_expr ~ (eq_op ~ rel_expr)* }
eq_op = { "==" | "!=" }
rel_expr = { add_expr ~ (rel_op ~ add_expr)* }
rel_op = { "<=" | ">=" | "<" | ">" }
add_expr = { mul_expr ~ (add_op ~ mul_expr)* }
add_op = { "+" | "-" }
mul_expr = { cast_expr ~ (mul_op ~ cast_expr)* }
mul_op = { "*" | "/" | "%" }

cast_expr = { unary_expr ~ (kw_as ~ type_name)* }

unary_expr = { unary_op ~ unary_expr | postfix_expr }
unary_op = { "-" | "!" }

postfix_expr = { primary_expr ~ (call_suffix | field_suffix | index_suffix | try_suffix)* }
// `xs[i]`: the element at `i` (out of range is a runtime error).
index_suffix = { "[" ~ expr ~ "]" }
// `expr?`: the `Ok`/`Some` value, or return the `Err`/`None` from the function.
try_suffix = { "?" }
call_suffix = { call_args }
field_suffix = { "." ~ ident }
call_args = { "(" ~ expr_list? ~ ")" }

// `if`/`match` are operands too: `1 + if c { 1 } else { 2 }`.
primary_expr = {
    if_expr
  | match_expr
  | closure_expr
  | struct_lit
  | array_lit
  | float_lit
  | int_lit
  | string_lit
  | bool_lit
  | ident
  | "(" ~ expr ~ ")"
}

closure_expr = { "|" ~ closure_params? ~ "|" ~ expr }
closure_params = { closure_param ~ ("," ~ closure_param)* }
closure_param = { ident ~ (":" ~ type_name)? }

array_lit = { "[" ~ expr_list? ~ "]" }
struct_lit = { ident ~ "{" ~ field_init ~ ("," ~ field_init)* ~ "}" }
field_init = { ident ~ ":" ~ expr }

param_list = { param ~ ("," ~ param)* }
param = { ident ~ ":" ~ type_name }
expr_list = { expr ~ ("," ~ expr)* }

type_ann = { ":" ~ type_name }
type_name = { function_type | generic_type | result_type | option_type | array_type | simple_type }
function_type = { "fn" ~ "(" ~ (type_name ~ ("," ~ type_name)*)? ~ ")" ~ ("->" ~ function_ret)? }
function_ret = { type_name }
generic_type = { ident ~ "[" ~ type_name ~ ("," ~ type_name)* ~ "]" }
option_type = { "Option" ~ "[" ~ type_name ~ "]" }
result_type = { "Result" ~ "[" ~ type_name ~ "," ~ type_name ~ "]" }
array_type = { "[" ~ type_name ~ "]" }
simple_type = { ident }

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Keywords that continue an expression or statement must end at a word
// boundary: otherwise `3` followed by a line `assert_eq(…)` parses as the
// cast `3 as sert_eq…`.
kw_end = _{ !(ASCII_ALPHANUMERIC | "_") }
kw_as = @{ "as" ~ kw_end }
kw_in = @{ "in" ~ kw_end }
kw_if = @{ "if" ~ kw_end }
kw_else = @{ "else" ~ kw_end }

float_lit = ${ digits ~ ("." ~ digits ~ exponent? | exponent) ~ float_suffix? ~ number_end }
float_suffix = _{ "f32" | "f64" }
int_lit = ${ (hex_digits | digits) ~ int_suffix? ~ number_end }
digits = _{ ASCII_DIGIT ~ ("_"? ~ ASCII_DIGIT)* }
hex_digits = _{ "0x" ~ ASCII_HEX_DIGIT ~ ("_"? ~ ASCII_HEX_DIGIT)* }
exponent = _{ ("e" | "E") ~ ("+" | "-")? ~ digits }
number_end = _{ !(ASCII_ALPHANUMERIC | "_") }
int_suffix = _{ "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" }
string_lit = ${ "\"" ~ string_content* ~ "\"" }
string_content = _{ string_escape | string_char | interp_expr }
string_escape = @{ "\\" ~ ANY }
string_char = @{ !( "\"" | "{" | "\\" ) ~ ANY }
// `{expr}`: any expression; whitespace is allowed inside the braces.
interp_expr = !{ "{" ~ expr ~ "}" }
bool_lit = @{ ("true" | "false") ~ kw_end }
