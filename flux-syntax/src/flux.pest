// U+FEFF: a byte-order mark that some editors write at the start of a file.
WHITESPACE = _{ " " | "\t" | "\r" | "\n" | "\u{FEFF}" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }

// `;` only separates items or statements on one line; it has no meaning.
program = { SOI ~ (item | ";")* ~ EOI }

item = {
    import_decl
  | type_alias_decl
  | struct_decl
  | enum_decl
  | trait_decl
  | impl_decl
  | event_decl
  | fn_decl
  | rfn_decl
  | watch_stmt
  | on_stmt
  | const_binding
  | derived_binding
  | let_binding
  | if_stmt
}

type_alias_decl = { pub_modifier? ~ "type" ~ ident ~ "=" ~ type_name }
const_binding = { pub_modifier? ~ "const" ~ ident ~ type_ann? ~ "=" ~ expr }
derived_binding = { pub_modifier? ~ "derived" ~ let_pattern ~ type_ann? ~ "=" ~ expr }
let_binding = { pub_modifier? ~ "let" ~ mut_modifier? ~ let_pattern ~ type_ann? ~ "=" ~ expr }
mut_modifier = { "mut" }
let_pattern = { struct_pat | tuple_binding | ident }
// `(a, b)`, `(name, (x, y))`: names for the values of a tuple.
tuple_binding = { "(" ~ binding_elem ~ ("," ~ binding_elem)+ ~ ","? ~ ")" }
binding_elem = { tuple_binding | ident }
import_decl = { "import" ~ import_path ~ import_as? ~ import_symbols? }
import_as = { kw_as ~ ident }
import_path = @{ (ASCII_ALPHANUMERIC | "_" | "." | "/")+ }
import_symbols = { "{" ~ ident_list ~ "}" }
// A comma may follow the last element of any list.
ident_list = { ident ~ ("," ~ ident)* ~ ","? }

pub_modifier = { "pub" }

struct_decl = { pub_modifier? ~ "struct" ~ ident ~ type_params? ~ struct_fields }
struct_fields = { "{" ~ struct_field ~ ("," ~ struct_field)* ~ ","? ~ "}" }
struct_field = { ident ~ ":" ~ type_name }

enum_decl = { pub_modifier? ~ "enum" ~ ident ~ type_params? ~ enum_variants }
enum_variants = { "{" ~ enum_variant ~ ("," ~ enum_variant)* ~ ","? ~ "}" }
enum_variant = { ident ~ enum_payload? }
enum_payload = { tuple_payload | struct_payload }
// More than one type parses so that the parser can explain the rule.
tuple_payload = { "(" ~ type_name ~ ("," ~ type_name)* ~ ","? ~ ")" }
struct_payload = { "{" ~ struct_field ~ ("," ~ struct_field)* ~ ","? ~ "}" }

event_decl = { pub_modifier? ~ "event" ~ ident ~ event_params? }
event_params = { "(" ~ param_list? ~ ")" }

type_params = { "[" ~ ident ~ ("," ~ ident)* ~ ","? ~ "]" }
// A function's or impl's type parameters may name traits: `[T: Ord + Display]`.
bounded_params = { "[" ~ type_param ~ ("," ~ type_param)* ~ ","? ~ "]" }
type_param = { ident ~ (":" ~ trait_bound ~ ("+" ~ trait_bound)*)? }
trait_bound = { path_ident | ident }

trait_decl = { pub_modifier? ~ "trait" ~ ident ~ trait_body }
trait_body = { "{" ~ trait_method* ~ "}" }
trait_method = { "fn" ~ ident ~ fn_sig ~ ";" }

// `impl Trait for Type { }`, or `impl Type { }` for the type's own methods
// and type functions.
impl_decl = { "impl" ~ bounded_params? ~ ((path_ident | ident) ~ kw_for)? ~ type_name ~ impl_body }
kw_for = @{ "for" ~ kw_end }
impl_body = { "{" ~ impl_method* ~ "}" }
impl_method = { "fn" ~ ident ~ fn_sig ~ block }

// `track fn` reads reactive values and tracks them; `act fn` changes state.
fn_decl = { pub_modifier? ~ fn_kind? ~ kw_fn ~ ident ~ bounded_params? ~ fn_sig ~ block }
fn_kind = { kw_track | kw_act }
kw_fn = @{ "fn" ~ kw_end }
kw_track = @{ "track" ~ kw_end }
kw_act = @{ "act" ~ kw_end }
// The older spelling of `track fn`.
rfn_decl = { pub_modifier? ~ kw_rfn ~ ident ~ type_params? ~ fn_sig ~ block }
kw_rfn = @{ "rfn" ~ kw_end }
// `self` alone, not `self: T` (an ordinary parameter named `self`).
fn_sig = { "(" ~ (self_param ~ &("," | ")") ~ ("," ~ param_list?)? | param_list)? ~ ")" ~ return_type? }
// `self` or `mut self`: the value a method is called on.
self_param = { mut_modifier? ~ kw_self }
kw_self = @{ "self" ~ kw_end }
return_type = { "->" ~ type_name }

// `watch total(prev) { }`: `prev` is the value the watch saw last time.
watch_stmt = { "watch" ~ (ident ~ watch_prev?)? ~ block }
watch_prev = { "(" ~ ident ~ ")" }
// `on Move(x, y) { }`; `on E { n -> }` is the older form for one value.
on_stmt = { "on" ~ ident ~ on_params? ~ handler }
on_params = { "(" ~ ident_list? ~ ")" }

handler = { "{" ~ handler_body ~ "}" }
handler_body = { handler_param ~ block_stmts | block_stmts }
handler_param = { ident ~ "->" }

block = { "{" ~ block_stmts ~ "}" }
block_stmts = { (stmt | ";")* }

stmt = {
    let_stmt
  | assign_stmt
  | emit_stmt
  | return_stmt
  | break_stmt
  | continue_stmt
  | if_stmt
  | while_stmt
  | for_stmt
  | watch_stmt
  | on_stmt
  | expr_stmt
}

// Keywords end at a word boundary: `breaker` is a name, not `break er`.
return_stmt = { kw_return ~ expr? }
kw_return = @{ "return" ~ kw_end }
break_stmt = @{ "break" ~ kw_end }
continue_stmt = @{ "continue" ~ kw_end }

let_stmt = { "let" ~ mut_modifier? ~ let_pattern ~ type_ann? ~ "=" ~ expr }
// `x = v`, or a part of `x`: an element `xs[i] = v`, `m[k] = v`, a field
// `p.x = v`, or a path of them `grid[i][j].done = v`; `+=`, `-=`, `*=`, `/=`,
// and `%=` combine the old value with the new one.
assign_stmt = { ident ~ place_step* ~ assign_op ~ expr }
place_step = { assign_index | assign_field }
assign_index = { "[" ~ expr ~ "]" }
assign_field = { "." ~ (ident | tuple_index) }
assign_op = { "+=" | "-=" | "*=" | "/=" | "%=" | "=" }
emit_stmt = { "emit" ~ ident ~ emit_args? }
emit_args = { "(" ~ expr_list? ~ ")" }
expr_stmt = { expr }

if_stmt = { "if" ~ expr ~ block ~ else_clause? }
else_clause = { kw_else ~ (if_stmt | block) }
while_stmt = { "while" ~ expr ~ block }
for_stmt = { "for" ~ (tuple_binding | ident) ~ kw_in ~ expr ~ block }

// Expressions — precedence low → high
// `match`/`if` are reached as operands (see `primary_expr`).
expr = { or_expr }

match_expr = { kw_match ~ or_expr ~ "{" ~ match_arm ~ ("," ~ match_arm)* ~ ","? ~ "}" }
kw_match = @{ "match" ~ kw_end }
match_arm = { match_pattern ~ guard? ~ "=>" ~ (arm_block | arm_jump | expr) }
// An arm that leaves instead of producing a value: `Err(e) => return Err(e)`.
arm_jump = { return_stmt | break_stmt | continue_stmt }
arm_block = { "{" ~ block_stmts ~ "}" }
guard = { kw_if ~ expr }
match_pattern = { lit_pat | tuple_value_pat | tuple_pat | struct_pat | simple_pat }
// `(0, y)`, `(Some(a), _)`: a tuple whose values match these patterns.
tuple_value_pat = { "(" ~ match_pattern ~ ("," ~ match_pattern)+ ~ ","? ~ ")" }
// Int, String, and Bool literals; compared with `==`.
lit_pat = { float_lit | neg_int_lit | int_lit | raw_string_lit | string_lit | bool_lit }
neg_int_lit = ${ "-" ~ int_lit }
simple_pat = { path_ident | ident }
// The payload may itself be a pattern: `Some(Num(n))`, `Ok(0)`, `Some(LParen)`.
tuple_pat = { (path_ident | ident) ~ "(" ~ (lit_pat | tuple_value_pat | tuple_pat | path_ident | ident_list)? ~ ")" }
struct_pat = { (path_ident | ident) ~ "{" ~ ident_list ~ "}" }

if_expr = { kw_if ~ or_expr ~ "{" ~ expr ~ "}" ~ kw_else ~ "{" ~ expr ~ "}" }

or_expr = { and_expr ~ ("||" ~ and_expr)* }
and_expr = { eq_expr ~ ("&&" ~ eq_expr)* }
eq_expr = { rel_expr ~ (eq_op ~ rel_expr)* }
eq_op = { "==" | "!=" }
rel_expr = { add_expr ~ (rel_op ~ add_expr)* }
rel_op = { "<=" | ">=" | "<" | ">" }
add_expr = { mul_expr ~ (add_op ~ mul_expr)* }
add_op = { "+" | "-" }
mul_expr = { cast_expr ~ (mul_op ~ cast_expr)* }
mul_op = { "*" | "/" | "%" }

cast_expr = { unary_expr ~ (kw_as ~ type_name)* }

unary_expr = { unary_op ~ unary_expr | postfix_expr }
unary_op = { "-" | "!" }

postfix_expr = { primary_expr ~ (call_suffix | field_suffix | index_suffix | try_suffix | with_suffix)* }
// `p with { x: 3 }`: a copy of the struct `p` with some fields changed.
with_suffix = { kw_with ~ "{" ~ field_init ~ ("," ~ field_init)* ~ ","? ~ "}" }
kw_with = @{ "with" ~ kw_end }
// `xs[i]`: the element at `i` (out of range is a runtime error).
index_suffix = { "[" ~ expr ~ "]" }
// `expr?`: the `Ok`/`Some` value, or return the `Err`/`None` from the function.
try_suffix = { "?" }
call_suffix = { call_args }
field_suffix = { "." ~ (ident | tuple_index) }
// `t.0`: a value of a tuple, counting from 0.
tuple_index = @{ ASCII_DIGIT+ }
call_args = { "(" ~ expr_list? ~ ")" }

// `if`/`match` are operands too: `1 + if c { 1 } else { 2 }`.
primary_expr = {
    if_expr
  | match_expr
  | closure_expr
  | struct_lit
  | array_lit
  | float_lit
  | int_lit
  | raw_string_lit
  | string_lit
  | bool_lit
  | path_ident
  | ident
  | paren_expr
}

// `(x)` groups; `(a, b)` is a tuple of two or more values. One rule for
// both, so that nested parentheses parse once each. `(x,)` parses so that it
// can be reported.
paren_expr = { "(" ~ expr ~ tuple_tail? ~ ")" }
tuple_tail = { "," ~ (expr ~ ("," ~ expr)* ~ ","?)? }

closure_expr = { "|" ~ closure_params? ~ "|" ~ expr }
closure_params = { closure_param ~ ("," ~ closure_param)* ~ ","? }
closure_param = { ident ~ (":" ~ type_name)? }

array_lit = { "[" ~ expr_list? ~ "]" }
struct_lit = { (path_ident | ident) ~ "{" ~ field_init ~ ("," ~ field_init)* ~ ","? ~ "}" }
field_init = { ident ~ ":" ~ expr }

param_list = { param ~ ("," ~ param)* ~ ","? }
param = { ident ~ ":" ~ type_name }
expr_list = { expr ~ ("," ~ expr)* ~ ","? }

type_ann = { ":" ~ type_name }
type_name = { function_type | tuple_type | generic_type | result_type | option_type | array_type | simple_type }
tuple_type = { "(" ~ type_name ~ ("," ~ type_name)+ ~ ","? ~ ")" }
function_type = { "fn" ~ "(" ~ (type_name ~ ("," ~ type_name)* ~ ","?)? ~ ")" ~ ("->" ~ function_ret)? }
function_ret = { type_name }
generic_type = { (path_ident | ident) ~ "[" ~ type_name ~ ("," ~ type_name)* ~ ","? ~ "]" }
option_type = { "Option" ~ "[" ~ type_name ~ ","? ~ "]" }
result_type = { "Result" ~ "[" ~ type_name ~ "," ~ type_name ~ ","? ~ "]" }
array_type = { "[" ~ type_name ~ "]" }
simple_type = { path_ident | ident }

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
// `math::sqrt`, `Point::new`, `Shape::Circle`: a name known at compile time,
// written without spaces around `::`.
path_ident = @{ ident ~ ("::" ~ ident)+ }

// Keywords that continue an expression or statement must end at a word
// boundary: otherwise `3` followed by a line `assert_eq(…)` parses as the
// cast `3 as sert_eq…`.
kw_end = _{ !(ASCII_ALPHANUMERIC | "_") }
kw_as = @{ "as" ~ kw_end }
kw_in = @{ "in" ~ kw_end }
kw_if = @{ "if" ~ kw_end }
kw_else = @{ "else" ~ kw_end }

float_lit = ${ digits ~ ("." ~ digits ~ exponent? | exponent) ~ float_suffix? ~ number_end }
float_suffix = _{ "f32" | "f64" }
int_lit = ${ (hex_digits | digits) ~ int_suffix? ~ number_end }
digits = _{ ASCII_DIGIT ~ ("_"? ~ ASCII_DIGIT)* }
hex_digits = _{ "0x" ~ ASCII_HEX_DIGIT ~ ("_"? ~ ASCII_HEX_DIGIT)* }
exponent = _{ ("e" | "E") ~ ("+" | "-")? ~ digits }
number_end = _{ !(ASCII_ALPHANUMERIC | "_") }
int_suffix = _{ "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" }
string_lit = ${ "\"" ~ string_content* ~ "\"" }
// `r"..."` and `r#"..."#`: the text as written, with no escapes and no `{...}`.
// Each `#` lets the text contain one more level of `"#`: it ends at `"` and
// the same number of `#`.
raw_string_lit = ${ "r" ~ PUSH("#"*) ~ "\"" ~ raw_string_text ~ "\"" ~ POP }
raw_string_text = @{ (!("\"" ~ PEEK) ~ ANY)* }
string_content = _{ string_escape | string_char | interp_expr }
string_escape = @{ "\\" ~ ANY }
string_char = @{ !( "\"" | "{" | "\\" ) ~ ANY }
// `{expr}`: any expression; whitespace is allowed inside the braces.
interp_expr = !{ "{" ~ expr ~ "}" }
bool_lit = @{ ("true" | "false") ~ kw_end }
