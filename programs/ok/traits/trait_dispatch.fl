// expect: compile ok — trait method dispatch picks the impl matching the receiver type
trait Display {
    fn to_string(x: Int) -> String;
}

impl Display for Int {
    fn to_string(self: Int) -> String {
        "int"
    }
}

impl Display for String {
    fn to_string(self: String) -> String {
        "string"
    }
}

let from_int = (7).to_string()
let from_string = "hi".to_string()
